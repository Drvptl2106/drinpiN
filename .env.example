# Copy this file to ".env" for running on your computer.
# Get both values in Supabase: Project Settings → API (or "Connect").
# The anon/publishable key is safe to put in a website: the database's
# security rules (supabase/schema.sql) decide what each person can see.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to "true" after turning on Google sign-in in Supabase (see SETUP.md).
VITE_ENABLE_GOOGLE=false
